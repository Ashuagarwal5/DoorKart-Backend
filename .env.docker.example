# Settings for the Backend Docker stack. Copy to .env.docker and edit; never commit .env.docker.
# Use a URL-safe database password (letters, digits, hyphens, underscores).
POSTGRES_USER=buynest
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=buynest

# development | production. Production expects HTTPS (secure admin cookie).
BACKEND_NODE_ENV=development

# Browser origin(s) of the admin panel, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Host port for the API.
API_PORT=4000

# Reverse proxies in front of the API (0 if reached directly).
TRUST_PROXY_HOPS=0
ADMIN_SESSION_TTL_HOURS=12

# Master key for saved secrets and sign-in code hashes: run `npm run secrets:key`, paste here.
# Keep a private copy; without it saved secrets must be entered again.
SECRETS_KEY=

