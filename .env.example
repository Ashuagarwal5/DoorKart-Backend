# Copy this file to .env and adjust. Never commit .env.

# PostgreSQL connection string.
# The value below matches the bundled dev database started by `npm run db:dev`.
# For your own PostgreSQL use: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/buynest

# Port the API listens on.
PORT=4000

# development | test | production
NODE_ENV=development

# Comma-separated browser origins allowed to call the API, with cookies: the admin panel's
# address (for example http://localhost:3000 in development, https://admin.yourshop.com in
# production). Admin requests that change data are refused from any other origin.
# Left empty: development allows any origin, production allows none.
# Native mobile apps are not affected by CORS.
CORS_ORIGINS=

# How long an admin stays signed in before they must sign in again (1 to 168 hours).
ADMIN_SESSION_TTL_HOURS=12

# How many reverse proxies sit in front of the API; 0 if it is reached directly.
# Set it when deployed behind one, so the login rate limit sees each visitor's real address.
TRUST_PROXY_HOPS=0

# Folder where uploaded product pictures and videos are stored (relative to this Backend folder).
# Back it up with the database: the database only stores each file's name. In production, put it
# on a disk that survives restarts and redeploys.
UPLOAD_DIR=uploads

# Master key for secrets saved in the admin panel (the email password) and for sign-in code hashes.
# Create one with `npm run secrets:key` and paste the line here in your own .env. Keep a private copy:
# without the same key, saved secrets cannot be read and must be entered again.
SECRETS_KEY=

# ---------------------------------------------------------------------------------------
# First admin account. Used ONLY by `npm run admin:create`, which reads these from the
# environment. There is no default password: set your own, run the command, then remove
# ADMIN_SEED_PASSWORD from this file. Choose a long passphrase (at least 10 characters).
# ---------------------------------------------------------------------------------------
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
