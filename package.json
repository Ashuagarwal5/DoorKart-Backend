{
  "name": "doorkart-backend",
  "version": "1.0.0",
  "private": true,
  "description": "DoorKart REST API (Express, Prisma, PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:reset-dev": "tsx scripts/reset-dev-data.ts",
    "seed:demo": "tsx scripts/seed-demo-catalog.ts",
    "secrets:key": "tsx scripts/make-secrets-key.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "docker:up": "docker compose --env-file .env.docker up --build -d",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f backend",
    "docker:ps": "docker compose --env-file .env.docker ps",
    "docker:migrate": "docker compose --env-file .env.docker exec backend npm run prisma:deploy -- --config prisma7.config.ts",
    "docker:admin-create": "docker compose --env-file .env.docker exec -e ADMIN_SEED_EMAIL -e ADMIN_SEED_NAME -e ADMIN_SEED_PASSWORD backend npm run admin:create"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "prisma": "7.10.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
